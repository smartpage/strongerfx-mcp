      "display": {
        "component": "table",
        "properties": {
          "downloadUrl": {
            "label": "Download audio",
            "format": "link"
          },
          "previewUrl": {
            "label": "MP3 preview",
            "format": "link"
          },
          "duration": {
            "label": "Seconds",
            "format": "number"
          },
          "source": {
            "label": "Source and licence",
            "format": "object"
          }
        }
      }
    }
