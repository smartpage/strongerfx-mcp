        "type": "string",
        "description": "Stable sound identifier."
      },
      "name": {
        "type": "string"
      },
      "category": {
        "type": "string"
      },
      "duration": {
        "type": "number",
        "description": "Duration in seconds."
      },
      "downloadUrl": {
        "type": "string",
        "description": "Public audio file URL in the requested format."
      },
      "previewUrl": {
        "type": "string",
        "description": "MP3 preview URL."
      },
      "selectedFormat": {
        "type": "string",
        "enum": [
          "wav",
          "mp3"
        ]
      },
      "mimeType": {
        "type": "string"
      },
      "audioBase64": {
        "type": "string",
